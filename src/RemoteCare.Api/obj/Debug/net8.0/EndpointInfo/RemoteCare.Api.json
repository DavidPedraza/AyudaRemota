            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "GenerateQrResponse": {
        "type": "object",
        "properties": {
          "pairingCode": {
            "type": "string",
            "nullable": true
          },
          "qrData": {
            "type": "string",
            "nullable": true
          },
          "expiresIn": {
            "type": "integer",
            "format": "int32"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "LoginRequest": {
        "required": [
          "email",
          "password"
