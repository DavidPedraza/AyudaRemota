        "type": "object",
        "properties": {
          "pairingCode": {
            "minLength": 1,
            "type": "string"
          },
          "deviceId": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "PairDevicesResponse": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "integer",
            "format": "int32"
          },
          "sessionUuid": {
            "type": "string",
            "nullable": true
          },
          "seniorDevice": {
